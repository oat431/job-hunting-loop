# job-hunting-loop — environment variables
# Copy to .env and fill in. NEVER commit .env.

# Required: any OpenAI-compatible endpoint
LLM_API_KEY=***
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Other working options:
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1

# Optional: self-hosted SearXNG for the websearch source (else DuckDuckGo HTML is used)
# SEARXNG_URL=http://localhost:8080
